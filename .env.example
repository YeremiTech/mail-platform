SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/mail_platform
DB_USERNAME=mail_platform
DB_PASSWORD=mail_platform
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Mail Platform
DELIVERY_PROCESSING_STALE_SECONDS=300
DELIVERY_HEARTBEAT_INTERVAL_MS=30000
# Grant general mail templates per client. Recovery and document copies use dedicated endpoints.
CLIENT_TEMPLATE_ACCESS=inventory=billing/invoice,billing=billing/invoice
CLIENT_DISPLAY_NAMES=inventory=Inventario,billing=Facturación
# Multiple client credentials: clientId=secret,clientId2=secret2. Every secret must be >= 32 bytes.
INTERNAL_API_KEYS=inventory=change-this-secret-at-least-32-bytes,billing=another-secret-at-least-32-bytes!!
# Use independent random secrets. Never commit real production values.
OTP_HMAC_SECRET=change-this-hmac-secret-at-least-32-bytes
# Base64 of exactly 32 random bytes. Example generation: openssl rand -base64 32
SENSITIVE_PAYLOAD_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Valor recomendado; solo activar true expresamente en un entorno de desarrollo aislado.
DOCS_PUBLIC=false

# v0.5: persistent client provisioning; use independent random 32+ byte secrets.
# A separate admin identity is required for /api/v1/admin/* operations.
ADMIN_API_KEY=replace-with-independent-random-secret-32-bytes-minimum
API_KEY_PEPPER=replace-with-another-independent-random-secret-at-least-32-bytes
# Only disable legacy keys after provisioning/reconfiguring every consuming application.
ALLOW_LEGACY_KEYS=true
# Base64-encoded 32 random bytes, independent of SENSITIVE_PAYLOAD_KEY.
WEBHOOK_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ATTACHMENTS_ORPHAN_RETENTION_HOURS=48
CAMPAIGN_DRAIN_SIZE=100
WEBHOOK_BATCH_SIZE=10

# v0.6: Enable antivirus in production; a scanner failure rejects uploads with HTTP 503.
ATTACHMENTS_AV_ENABLED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
# Production: SPRING_PROFILES_ACTIVE=production (forces AV on and legacy credentials off)
# SPRING_PROFILES_ACTIVE=production

# Required for MARKETING campaigns; use your public HTTPS domain in production.
# MARKETING_PUBLIC_BASE_URL=https://mail.example.com
MARKETING_UNSUBSCRIBE_TOKEN_DAYS=90

# Enable only after verifying downstream DKIM signatures cover List-Unsubscribe and List-Unsubscribe-Post.
MARKETING_ONE_CLICK_ENABLED=true
