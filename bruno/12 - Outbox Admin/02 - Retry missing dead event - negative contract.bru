tests {
  test("HTTP 404", function() {
    expect(res.getStatus()).to.equal(404);
  });
  
  test("Missing dead event is rejected", function() {
    expect(res.getStatus()).to.equal(404);
  });
}

settings {
  encodeUrl: true
  timeout: 30000
}
