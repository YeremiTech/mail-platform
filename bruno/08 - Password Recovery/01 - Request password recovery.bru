meta {
  name: Request password recovery
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/password-recovery/challenges
  body: json
  auth: none
}

headers {
  X-Client-Id: {{testClientId}}
  X-Internal-Api-Key: {{clientApiKey}}
  Content-Type: application/json
}

body:json {
{
  "subjectReference": "bruno-user-{{runId}}",
  "email": "{{recoveryEmail}}"
}
}

script:post-response {
  const body = res.getBody(); if (body && body.challengeId) bru.setVar("challengeId", body.challengeId);
}

tests {
  test("HTTP 202", function() {
    expect(res.getStatus()).to.equal(202);
  });
}

settings {
  encodeUrl: true
  timeout: 30000
}
