meta {
  name: Mailpit find recovery message
  type: http
  seq: 2
}

get {
  url: {{mailpitUrl}}/api/v1/messages
  body: none
  auth: none
}

script:pre-request {
  await bru.sleep(2500);
}

script:post-response {
  const body = res.getBody();
  const messages = (body && body.messages) || [];
  const target = (bru.getVar("recoveryEmail") || "").toLowerCase();
  const found = messages.find(m => ((m.To || []).some(x => (x.Address || "").toLowerCase() === target)));
  if (found) bru.setVar("recoveryMessageId", found.ID);
  test("Recovery email appears in Mailpit", function() { expect(found).to.exist; });
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 30000
}
