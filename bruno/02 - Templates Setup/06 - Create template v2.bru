  "html": "<html><body><h1>Hola desde Bruno v2</h1><p>Plantilla Bruno v2.</p></body></html>",
  "text": "Hola desde Bruno v2. Plantilla Bruno v2.",
  "requiredVariables": []
}
}

tests {
