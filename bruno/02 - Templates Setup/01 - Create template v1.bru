meta {
  name: Create template v1
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/templates/{{templateSlug}}
  body: json
  auth: none
}

headers {
  X-Client-Id: {{testClientId}}
  X-Internal-Api-Key: {{clientApiKey}}
  Content-Type: application/json
}

body:json {
{
  "html": "<html><body><h1>Hola desde Bruno</h1><p>Mensaje de prueba Bruno.</p></body></html>",
  "text": "Hola desde Bruno. Mensaje de prueba Bruno.",
  "requiredVariables": []
}
}

tests {
  test("HTTP 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

settings {
  encodeUrl: true
  timeout: 30000
}
