meta {
  name: Submit RFC8058 one-click generic response
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/public/unsubscribe/one-click
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  token: invalid-token
  List-Unsubscribe: One-Click
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 30000
}
