meta {
  name: Unpublish test template
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/api/v1/templates/{{templateSlug}}/publication
  body: none
  auth: none
}

headers {
  X-Client-Id: {{testClientId}}
  X-Internal-Api-Key: {{clientApiKey}}
}

tests {
  test("HTTP 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}

settings {
  encodeUrl: true
  timeout: 30000
}
