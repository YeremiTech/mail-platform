meta {
  name: Issue secondary credential
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/admin/clients/{{testClientId}}/credentials
  body: json
  auth: none
}

headers {
  X-Client-Id: admin
  X-Internal-Api-Key: {{adminApiKey}}
  Content-Type: application/json
}

body:json {
{
  "ttlDays": 1
}
}

script:post-response {
  const body = res.getBody();
  if (body && body.credentialId) bru.setVar("rotatedCredentialId", body.credentialId);
  if (body && body.apiKey) bru.setVar("rotatedApiKey", body.apiKey);
}

tests {
  test("HTTP 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

settings {
  encodeUrl: true
  timeout: 30000
}
